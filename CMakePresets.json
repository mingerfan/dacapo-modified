{
 "version": 2,
 "configurePresets": [
  {
   "name": "nix",
   "displayName": "Nix development",
   "description": "Uses the LLVM/MLIR toolchain exported by nix develop",
   "generator": "Ninja",
   "binaryDir": "${sourceDir}/build/${presetName}",
   "cacheVariables": {
    "CMAKE_BUILD_TYPE": "RelWithDebInfo",
    "CMAKE_C_COMPILER": "clang",
    "CMAKE_CXX_COMPILER": "clang++",
    "MLIR_DIR": "$env{MLIR_DIR}",
    "LLVM_DIR": "$env{LLVM_DIR}",
    "MLIR_TABLEGEN_EXE": "$env{MLIR_TABLEGEN_EXE}",
    "LLVM_TABLEGEN_EXE": "$env{LLVM_TABLEGEN_EXE}",
    "HECATE_ENABLE_SEAL_RUNTIME": "OFF",
    "HECATE_ENABLE_HEAAN_RUNTIME": "OFF",
    "BUILD_TESTING": "ON"
   }
  },
  {
   "name": "release",
   "displayName": "Release",
   "description": "Sets Ninja generator, build and install directory",
   "generator": "Ninja",
   "binaryDir": "${sourceDir}/build/${presetName}",
   "cacheVariables": {
    "CMAKE_BUILD_TYPE": "Release",
    "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/${presetName}",
    "CMAKE_TOOLCHAIN_FILE": "",
    "MLIR_ROOT": "$env{HOME}/llvm-project",
    "SEAL_ROOT": "$env{HOME}/SEAL",
    "HEaaN_ROOT": "$env{HOME}/HEaaN"
   }
  },
  {
   "name": "debug",
   "displayName": "Debug",
   "description": "Sets Ninja generator, build and install directory",
   "generator": "Ninja",
   "binaryDir": "${sourceDir}/build-${presetName}",
   "cacheVariables": {
    "CMAKE_BUILD_TYPE": "Debug",
    "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/${presetName}",
    "MLIR_ROOT": "$env{HOME}/llvm-project",
    "SEAL_ROOT": "$env{HOME}/SEAL",
    "HEaaN_ROOT": "$env{HOME}/HEaaN"
   }
  }
 ],
 "buildPresets": [
  {
   "name": "nix",
   "configurePreset": "nix"
  }
 ]
}
